{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Site",
  "type": "object",
  "required": ["id", "name", "url", "type", "status", "paused"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "tenant": { "type": "string", "default": "default" },
    "name": { "type": "string" },
    "client": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "type": { "enum": ["existing", "new", "revamp"] },
    "status": { "enum": ["pending_connect", "onboarding", "active", "error", "archived"] },
    "paused": { "type": "boolean" },
    "builder": { "enum": ["elementor", "gutenberg", "classic", "divi", "wpbakery", "bricks", "unknown"] },
    "theme": { "type": "string" },
    "css_prefix": { "type": "string", "pattern": "^[a-z]{2,6}-$" },
    "bridge": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "site_key_id": { "type": "string" },
        "connected_at": { "type": "string", "format": "date-time" },
        "checks": { "type": "object" }
      }
    },
    "channels": {
      "type": "object",
      "properties": { "discord_channel_id": { "type": "string" } }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
